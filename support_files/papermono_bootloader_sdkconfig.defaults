# PaperMono persistent recovery. These are standard ESP-IDF bootloader options.
# KEY1 is ESP32-S3 GPIO2, externally pulled up and asserted low when pressed.
CONFIG_BOOTLOADER_FACTORY_RESET=y
CONFIG_BOOTLOADER_NUM_PIN_FACTORY_RESET=2
CONFIG_BOOTLOADER_FACTORY_RESET_PIN_LOW=y
# CONFIG_BOOTLOADER_FACTORY_RESET_PIN_HIGH is not set
CONFIG_BOOTLOADER_OTA_DATA_ERASE=y
CONFIG_BOOTLOADER_DATA_FACTORY_RESET=""
CONFIG_BOOTLOADER_HOLD_TIME_GPIO=3

# CONFIG_BOOTLOADER_APP_TEST is not set
